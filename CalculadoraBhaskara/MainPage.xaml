<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CalculadoraBhaskara.MainPage">
  <ScrollView><VerticalStackLayout Padding="24,36" Spacing="16" MaximumWidthRequest="560" HorizontalOptions="Fill">
    <Label Text="PROGRAMAÇÃO MOBILE" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
    <Label Text="Fórmula de Bhaskara" FontSize="30" FontAttributes="Bold" />
    <Label Text="Resolva uma equação do segundo grau: ax² + bx + c = 0." TextColor="#52647B" />
    <Border><VerticalStackLayout Spacing="9"><Label Text="A — coeficiente quadrático" FontAttributes="Bold"/><Entry x:Name="A" Placeholder="Ex.: 1" Keyboard="Text" ClearButtonVisibility="WhileEditing" /><Label Text="B — coeficiente linear" FontAttributes="Bold"/><Entry x:Name="B" Placeholder="Ex.: -5" Keyboard="Text" ClearButtonVisibility="WhileEditing" /><Label Text="C — constante" FontAttributes="Bold"/><Entry x:Name="C" Placeholder="Ex.: 6" Keyboard="Text" ClearButtonVisibility="WhileEditing" /></VerticalStackLayout></Border>
    <Label Text="Δ = b² − 4ac   |   x = (−b ± √Δ) / 2a" HorizontalTextAlignment="Center" TextColor="#52647B" />
    <Button Text="Calcular Raízes" Clicked="OnCalculate"/>
    <Border><VerticalStackLayout Spacing="8"><Label Text="RESULTADO" FontSize="12" FontAttributes="Bold"/><Label x:Name="Delta" Text="Δ = —" FontSize="21" FontAttributes="Bold"/><Label x:Name="Root1" Text="X₁ = —" FontSize="22" TextColor="{StaticResource Accent}"/><Label x:Name="Root2" Text="X₂ = —" FontSize="22" TextColor="{StaticResource Accent}"/><Label x:Name="Feedback" Text="Preencha os três coeficientes."/></VerticalStackLayout></Border>
    <Button Text="Limpar" BackgroundColor="#475569" Clicked="OnClear" />
  </VerticalStackLayout></ScrollView>
</ContentPage>